rules_version = '2';

// Hiper Higienizações - regras de acesso do Firestore.
// Modelo: todo dado da empresa vive sob usuarios/{uid}, então o isolamento
// é garantido pelo próprio caminho do documento. Nada fora dessa árvore é
// legível ou gravável, e o acesso anônimo é sempre negado.

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil da empresa: usuarios/{uid}
    match /usuarios/{uid} {
      allow read, write: if ehDono(uid);

      // Coleções operacionais: clientes, servicos, equipes,
      // agendamentos e lancamentos.
      match /{colecao}/{documento} {
        allow read, delete: if ehDono(uid);
        allow create, update: if ehDono(uid)
          && colecao in ['clientes', 'servicos', 'equipes', 'agendamentos', 'lancamentos']
          && request.resource.data.keys().size() <= 40;
      }
    }
  }
}
